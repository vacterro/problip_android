    <!-- Help -->
    <string name="help_a11y">Help</string>
    <string name="help_title">HELP</string>
    <string name="help_quick_start">QUICK START</string>
    <string name="help_qs_volume">• Choose the volume.</string>
    <string name="help_qs_interval">• Choose the interval.</string>
    <string name="help_qs_sounds">• Choose the sounds.</string>
    <string name="help_qs_start">• Press START.</string>
    <string name="help_qs_minimize">• MINIMIZE backgrounds Problip without stopping it.</string>
    <string name="help_qs_exit">• EXIT stops the session and closes the app.</string>
    <string name="help_intervals">INTERVALS</string>
    <string name="help_intervals_body">• 4-7 — random seconds between blips.\n• 5 / 10 / 15 / 20 / 30 — fixed presets.\n• PULSE — every 5 sec, alternating with a random 10-20 sec.\n• MANUAL — your own FROM and TO seconds. (premium)</string>
    <string name="help_premium">PREMIUM / TRIAL</string>
    <string name="help_premium_body">• Premium content can be tried for 5 minutes.\n• Trials do not renew automatically.\n• A new trial can be started manually at any time.\n• A purchase is permanent and never expires.</string>
    <string name="help_statistics">STATISTICS</string>
    <string name="help_statistics_body">• Only successful blips are counted.\n• Settings shows Today / This week / This month / Total.\n• 100,000 total blips unlock Premium locally, forever.\n• Progress is local app data — Problip has no account and no server.</string>
    <string name="help_background">BACKGROUND</string>
    <string name="help_background_body">• While playing, Problip shows a permanent notification.\n• The notification STOP button stops playback without reopening the app.</string>
    <string name="help_tips">TIPS</string>
    <string name="help_tips_body">• Turn the volume down before locking the screen.\n• The widget starts and stops a session from the home screen.\n• Themes and sounds stay selected after a trial ends.</string>
    <string name="help_faq">FAQ</string>
    <string name="help_faq_notif_q">Why is there a notification?</string>
    <string name="help_faq_notif_a">Android requires it for background playback, and it carries the STOP button.</string>
    <string name="help_faq_minimize_q">Does MINIMIZE stop Problip?</string>
    <string name="help_faq_minimize_a">No.</string>
    <string name="help_faq_exit_q">Does EXIT stop Problip?</string>
    <string name="help_faq_exit_a">Yes.</string>
    <string name="help_faq_renew_q">Do trials renew automatically?</string>
    <string name="help_faq_renew_a">No.</string>
    <string name="help_faq_expire_q">Do purchases expire?</string>
    <string name="help_faq_expire_a">No.</string>
    <string name="help_faq_theme_q">Why did a premium theme return to Golden Default?</string>
    <string name="help_faq_theme_a">Its temporary access expired.</string>
