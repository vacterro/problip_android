<?xml version="1.0" encoding="utf-8"?>
<!-- 1x1-first: the whole useful region is one START/STOP surface. A compact
     header shows the brand mark (or the mark + PROBLIP + status on wider
     launchers that hide nothing) and the button fills the rest. No extra
     controls at any size: the widget is START/STOP only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_mark"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_problip_mark" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:maxLines="1"
            android:text="@string/widget_title"
            android:textColor="@color/problip_gold"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:gravity="end|center"
            android:maxLines="1"
            android:text="@string/widget_status_off"
            android:textColor="@color/problip_text_dim"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_button"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:background="@drawable/widget_button"
        android:fontFamily="monospace"
        android:gravity="center"
        android:letterSpacing="0.15"
        android:minHeight="36dp"
        android:text="@string/widget_button_start"
        android:textColor="@color/problip_gold"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>