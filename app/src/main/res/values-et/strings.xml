    <string name="help_a11y">Abi</string>
    <string name="help_title">ABI</string>
    <string name="help_quick_start">KIIRE ALUSTAMINE</string>
    <string name="help_qs_volume">• Vali helitugevus.</string>
    <string name="help_qs_interval">• Vali intervall.</string>
    <string name="help_qs_sounds">• Vali helid.</string>
    <string name="help_qs_start">• Vajuta START.</string>
    <string name="help_qs_minimize">• MINIMEERI viib Problipi taustale, sessiooni peatamata.</string>
    <string name="help_qs_exit">• VÄLJU peatab sessiooni ja sulgeb rakenduse.</string>
    <string name="help_intervals">INTERVALLID</string>
    <string name="help_intervals_body">• 4-7 — juhuslikud sekundid helide vahel.\n• 5 / 10 / 15 / 20 / 30 — fikseeritud intervallid.\n• PULSS — iga 5 s, vaheldumisi juhuslike 10-20 s.\n• KÄSITSI — oma ALATES ja KUNI sekundid. (premium)</string>
    <string name="help_premium">PREMIUM / PROOV</string>
    <string name="help_premium_body">• Premiumi sisu saab proovida 5 minutit.\n• Proovid ei uuene automaatselt.\n• Uue proovi saab käsitsi alustada igal ajal.\n• Ost on jäädav ja ei aegu.</string>
    <string name="help_statistics">STATISTIKA</string>
    <string name="help_statistics_body">• Loendatakse ainult õnnestunud bliibid.\n• Seadetes: täna / sel nädalal / sel kuul / kokku.\n• 100 000 bliibi avab premiumi lokaalselt igaveseks.\n• Edening on rakenduse enda andmes — Problipil ei ole kontot ega serverit.</string>
    <string name="help_background">TAUST</string>
    <string name="help_background_body">• Taasesituse ajal näitab Problip püsivat märguannet.\n• Märguanne STOP nupp peatab taasesituse ilma rakendust avamata.</string>
    <string name="help_tips">NÄPUNÄIDED</string>
    <string name="help_tips_body">• Vähenda helitugevus enne ekraani lukustamist.\n• Vidin käivitab ja peatab sessiooni avakuvalt.\n• Pärast proovi lõppu jäävad teema ja helid valituks.</string>
    <string name="help_faq">KÜSIMUSED</string>
    <string name="help_faq_notif_q">Miks on märguanne olemas?</string>
    <string name="help_faq_notif_a">Android nõuab seda taustases ja seal on STOP nupp.</string>
    <string name="help_faq_minimize_q">Kas MINIMEERI peatab Problipi?</string>
    <string name="help_faq_minimize_a">Ei.</string>
    <string name="help_faq_exit_q">Kas VÄLJU peatab Problipi?</string>
    <string name="help_faq_exit_a">Jah.</string>
    <string name="help_faq_renew_q">Kas proovid uuenevad automaatselt?</string>
    <string name="help_faq_renew_a">Ei.</string>
    <string name="help_faq_expire_q">Kas ostud aeguvad?</string>
    <string name="help_faq_expire_a">Ei.</string>
    <string name="help_faq_theme_q">Miks premiumi teema läks tagasi Golden Default juurde?</string>
    <string name="help_faq_theme_a">Ajutine ligipääs aegus.</string>
</resources>
