<!-- Notification small icon: monochrome alpha silhouette — white geometry on a
     transparent background, hole punched by even-odd winding. The system tints
     the whole layer; an opaque fill color could never create a transparent hole,
     so there is deliberately no second color here. Same mark as the launcher. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M2,2h20v20h-20z M5,5h14v14h-14z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M9,9h6v6h-6z" />
</vector>